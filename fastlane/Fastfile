default_platform(:ios)

# -----------------------------------------------
# Android
# -----------------------------------------------
platform :android do
  desc "Firebase App Distribution 내부 배포"
  lane :distribute do
    # versionCode/versionName은 expo prebuild 시점에 app.config.js가 주입
    gradle(
      project_dir: "android",
      task: "assemble",
      build_type: "Release"
    )
    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_APP_ID_ANDROID"),
      service_credentials_file: "firebase-service-account.json",
      android_artifact_type: "APK",
      groups: "internal-testers",
      release_notes: last_git_commit[:message]
    )
  end
end

# -----------------------------------------------
